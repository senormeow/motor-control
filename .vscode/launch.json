// The format of this file is specified in https://probe.rs/docs/tools/debugger/#start-a-debug-session-with-minimum-configuration
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB Session",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/target/thumbv6m-none-eabi/debug/motor-control",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "localhost:1337",
            "miDebuggerArgs": "-iex set auto-solib-add 0",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set target architecture to ARM",
                    "text": "set architecture arm", // Explicitly set architecture
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Debug Cortex",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/target/thumbv6m-none-eabi/debug/motor-control",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "toolchainPrefix": "arm-none-eabi",
            //"gdbPath": "gdb-multiarch",
            "gdbTarget": "localhost:1337",
            "device": "rp2040",
            //"runToEntryPoint": "main",
            //"svdFile": "${workspaceRoot}/svd/TM4C123GH6PM.svd",
            //"configFiles": [
            //    "board/ek-tm4c123gxl.cfg"
            //],
            "postLaunchCommands": [
                "break main",
                "continue"
            ]
        },
        {
            "preLaunchTask": "rust: cargo build",
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "rp2040-project",
            "cwd": "${workspaceFolder}",
            "chip": "rp2040",
            // RP2040 doesn't support connectUnderReset
            "connectUnderReset": false,
            "speed": 4000,
            "runtimeExecutable": "probe-rs",
            "runtimeArgs": [
                "dap-server"
            ],
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true,
                "restoreUnwrittenBytes": false
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/thumbv6m-none-eabi/debug/motor-control",
                    "rttEnabled": true
                    // Uncomment this if you've downloaded the SVD from
                    // https://github.com/raspberrypi/pico-sdk/raw/1.3.1/src/rp2040/hardware_regs/rp2040.svd
                    // and placed it in the .vscode directory
                    // "svdFile": "./.vscode/rp2040.svd",
                }
            ],
            "consoleLogLevel": "Debug", //Error, Warn, Info, Debug
            "wireProtocol": "Swd"
        },
        {
            "type": "probe-rs-debug",
            "request": "attach",
            "name": "probe_rs Executable launch example",
            "cwd": "${workspaceFolder}",
            //!MODIFY (or remove)
            "speed": 24000,
            //!MODIFY
            "chip": "RP2040",
            //!MODIFY (or remove)
            //"probe": "VID:PID:<Serial>",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    //!MODIFY
                    "programBinary": "target/thumbv6m-none-eabi/debug/motor-control",
                    //!MODIFY
                    //"svdFile": "Relative or fully qualified path to the CMSIS-SVD file for your target core"
                }
            ],
            "env": {
                //!MODIFY (or remove)
                // If you set this variable, check the VSCode console log window for the location of the log file.
                "RUST_LOG": "info"
            },
            // Info, Debug
            "consoleLogLevel": "Console"
        }
    ]
}